# OKX 선물 자동매매 봇 설정 (첫 5분봉 + 1분봉 FVG, 바이낸스 FVG 봇과 같은 규칙, 2026-10-28 추가).
# 이 파일을 복사해 .env.okx 로 저장하고 키를 넣으세요 (.env.okx 는 git 에 올라가지 않음)
# API 키 만들기: OKX > 프로필 > API > API 키 만들기 → 권한은 '읽기'와 '거래'만, '출금'은 절대 켜지 마세요.
#  키를 만들 때 정한 '패스프레이즈(비밀 문구)'도 아래에 넣어야 해요. IP 제한을 걸면 더 안전해요.
# 계정 준비: 앱 > 거래 설정 > 계정 모드 '현물 및 선물'(또는 그 위), 포지션 모드 '단방향(순포지션)'
EXCHANGE=okx
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# OKX 모의 거래 계정 키로 시험할 때만 true (모의 거래용 키를 따로 만들어야 함)
OKX_DEMO=false

# true = 주문 없이 로그만 (2026-10-28 사용자 결정: 드라이런 며칠 확인 뒤 실전). 실제 주문은 false
OKX_DRY_RUN=true

# 전략 (사용자 선택 2026-10-05: 하루 2종목 x 종목당 5배. 백테스트 2026-06~09 1000 → 67,673달러, 강제청산 없음,
#  최대 낙폭 -69%, 하루 최악 -52%. 2026-01~10 복리 +10635%, 고정 금액 +953%)
# 종목당 평가금액 x BN_LEVERAGE 배로 진입. 2종목을 동시에 들면 합계 최대 10배
BN_LEVERAGE=5
# 거래소 레버리지 설정값 (5배 두 종목의 증거금이 모자라지 않게 20, 종목 최대치를 넘으면 최대치로). 주문마다 교차 마진
BN_EXCHANGE_LEVERAGE=20
# 하루 최대 종목 수 (먼저 체결된 순). 1 = 하루 한 종목 (복리 +500% MDD -22%), 3 은 비추천 (3번째 신호가 약함)
BN_MAX_TRADES=2
BN_TOP_N=10
# 순위와 상관없이 늘 넣을 종목 (예 BTCUSDT,ETHUSDT). 백테스트 안 된 조건이라 기본은 비움
BN_EXTRA_SYMBOLS=
# 순위에서 뺄 종목: 롱 짝이 있는 인버스 ETF (SOXL↔SOXS, TQQQ↔SQQQ, SKUU↔SKDD 중 롱만 매매). 비우면 모두 포함
BN_EXCLUDE=SOXSUSDT,SQQQUSDT,SKDDUSDT
# 진입가~손절선(첫 5분봉 반대편) 거리가 이 % 를 넘는 신호는 건너뜀 (2026-10-09 사용자 결정. 0 = 제한 없음).
# 백테스트 2종목 x 5배: 고정 +962 → +916%, 최악의 날 -39 → -35% (5% 넘는 18건은 큰 수익 몇 건 빼면 손실)
BN_MAX_STOP_PCT=5
# 숏인데 이미 많이 내려온 자리는 건너뜀 (2026-10-21 사용자 결정, 10-20 NVDA 처럼 고점에서 장대음봉이 나온 뒤의 숏. 0 = 끔).
# 그날 고점→진입가 하락폭이 ADR(20일 평균 변동폭)의 0.6배 이상이거나, 익절가까지 그날 폭이 ADR 의 2배 이상 필요하면 제외
# 백테스트 8개월 337건 중 1건만 해당 (고정 +916 → +894%, 차이는 잡음 수준)
BN_SHORT_MAX_USED=0.6
BN_SHORT_MAX_NEED=2
BN_TARGET_R=2
BN_EXIT_MINUTES=350
BN_SIDE=both
BN_ENTRY=full
BN_LOC=zone
BN_POLL_SECONDS=1
# 키 없이 드라이런할 때 쓸 평가금액 (USDT)
BN_DRY_EQUITY=1000
BN_STATE_DIR=state_okx

# 종가 매매 (오버나이트, 롱만. 2026-10-06 추가): 미국 동부 15:58 에 장중(시가 대비) -BN_ON_DROP% 이하로 내리고
# 저가 근처에서 끝나는 종목을 많이 내린 순으로 BN_ON_MAX 종목까지 평가금액 x BN_ON_LEVERAGE 배씩 시장가 매수 →
# 다음 거래일 9:30 시장가 매도. 낮 전략과 시간이 안 겹쳐 같은 돈을 씀. 백테스트: 주식 4년 모두 이익(거래당 +0.3~3%),
# 바이낸스 8개월 2종목 x 1배 +91% (MDD -12%), 낮 전략과 함께 고정 금액 +936 → +1010%. 2026-10-15 사용자 결정으로 끔(단타만), 켜려면 true
BN_ON_ENABLED=false
BN_ON_LEVERAGE=1
BN_ON_MAX=2
BN_ON_DROP=10
# 종가 위치 = (현재가-저가)/(고가-저가) 가 이 값 미만 (0 = 저가에서 끝남)
BN_ON_POS=0.1
# 거래소 비상 손절 = 매수가 -N% (좁은 손절은 백테스트에서 수익·낙폭 모두 나빠 넓게 둠)
BN_ON_STOP=15
# 오늘 정규장 거래대금(USDT) 하한
BN_ON_MIN_QV=1000000
