# 토스증권 WTS > 설정 > Open API 에서 발급
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 비워두면 계좌 목록의 첫 번째 종합매매(BROKERAGE) 계좌 사용
TOSS_ACCOUNT_SEQ=

# true 이면 시세/계좌는 실제로 조회하되 주문은 보내지 않고 모의 체결 처리 (기본값 true)
DRY_RUN=true

# 자금: 동시 보유 최대 NUM_STOCKS 종목, 종목당 TOTAL_BUDGET / NUM_STOCKS
TOTAL_BUDGET=1000000
NUM_STOCKS=10

# 손절(-%, 시장가) / 익절(+%, 지정가). 둘 중 하나가 걸릴 때까지 보유
STOP_LOSS_PCT=4.7
TAKE_PROFIT_PCT=15
# 손절/익절을 토스증권 조건주문으로 서버에 걸어둠 (false 면 봇 가격감시만 사용)
USE_CONDITIONAL_ORDERS=true
# 조건주문 만료일 = 등록일 + N일 (만료되면 자동으로 다시 등록)
CONDITIONAL_EXPIRE_DAYS=30

# 종가배팅 매수 시간대 (매 거래일)
BUY_START=15:10
BUY_END=15:20
# 봇 가격 감시(조건주문 백업) 주기(초)
MONITOR_INTERVAL_SECONDS=60

# 종목 선정 조건
MIN_CHANGE_PCT=2
MAX_CHANGE_PCT=20
MIN_TRADING_AMOUNT=10000000000
MIN_VOLUME_RATIO=2
MIN_CLOSE_TO_HIGH=0.97

STATE_DIR=state
LOG_DIR=logs
