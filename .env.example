# 토스증권 WTS > 설정 > Open API 에서 발급
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 비워두면 계좌 목록의 첫 번째 종합매매(BROKERAGE) 계좌 사용
TOSS_ACCOUNT_SEQ=

# true 이면 시세/계좌는 실제로 조회하되 주문은 보내지 않고 모의 체결 처리 (기본값 true)
DRY_RUN=true

# 전략 파라미터
TOTAL_BUDGET=1000000
NUM_STOCKS=10
STOP_LOSS_PCT=5
TAKE_PROFIT_PCT=15

# 매수 시각(정규장 시작 후 N분), 청산 시각(종가 단일가 시작 N분 전)
BUY_DELAY_MINUTES=10
LIQUIDATION_LEAD_MINUTES=10
# 손절/익절 감시 주기(초)
MONITOR_INTERVAL_SECONDS=60

# 종목 선정 필터
UNIVERSE_FILE=universe.txt
MIN_AVG_TRADED_VALUE=3000000000
MAX_5D_RETURN_PCT=15

STATE_DIR=state
LOG_DIR=logs
