# 이평선 눌림 매매 실거래 봇 설정. 이 파일을 복사해 .env.ma 로 저장하세요 (.env.ma 는 git 에 올라가지 않음)
# 바이낸스 '서브 계정'을 만들어 그 계정의 API 키를 넣는 걸 권해요 (SOXL 스플릿 봇과 포지션이 섞이지 않게).
# API 키: "선물 거래 허용(Enable Futures)" 만 켜고 출금 허용은 절대 켜지 마세요. 가능하면 IP 제한도 거세요.
# 선물 설정은 '단방향(One-way)' 포지션 모드여야 해요.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true = 주문 없이 가상 계좌로 (진짜 시세로 체결을 흉내). 며칠 확인한 뒤 false 로 바꾸면 실제 주문
MA_DRY_RUN=true
# 드라이런 가상 계좌 시작 금액 (USDT)
MA_PAPER_EQUITY=1000

# 화면에서 '자동 매매 시작'·'롱/숏 시장가'를 누를 때 넣는 비밀번호 (실제 주문이면 꼭 필요). 숫자 4자리 이상 권장
MA_PIN=

# 한 번 투입금(증거금, USDT)과 배율의 상한. 화면에서 이보다 크게 넣으면 봇이 거부해요
MA_MAX_USDT=100
MA_MAX_LEV=5

# 비상 손절 %: 화면 규칙의 손절이 걸리지 않는 동안(손절 '없음', 손절선이 가격 반대쪽에 있음 등) 진입가 대비 이만큼에 거래소 손절을 걸어 둬요 (0 = 끔)
MA_SAFETY_STOP=10
