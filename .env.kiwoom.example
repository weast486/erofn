# 키움 단타 봇 설정. 이 파일을 복사해 .env.kiwoom 으로 저장하고 키를 넣으세요 (.env.kiwoom 은 git 에 올라가지 않음)
# 키움 REST API 신청: 키움증권 홈페이지 > 트레이딩 채널 > REST API (모의투자 키를 먼저 발급)
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=

# 처음에는 반드시 모의투자(true) + 드라이런(true) → 모의투자(true) + 드라이런(false) → 실전(false) 순서로
KIWOOM_MOCK=true
KIWOOM_DRY_RUN=true

# 전략 (백테스트 3년 기준 수익형: 전일 +20%↑, 하루 3종목 x 평가금액 33%, 손절 -10%, 익절 +7%, 12시 정리)
KW_MIN_PREV_CHANGE=20
KW_MIN_AVG_AMOUNT=3000000000
KW_MAX_PRICE=100000
KW_BUY_UNTIL=09:05
KW_POSITION_PCT=33
KW_MAX_POSITIONS=3
KW_MAX_CHASE_PCT=1.5
KW_ENTRY_SLIP_PCT=0.5
KW_FILL_TIMEOUT_SEC=20
KW_STOP_PCT=10
KW_TAKE_PROFIT_PCT=7
KW_EXIT_TIME=12:00
KW_POLL_SECONDS=2

# ETF 오버나이트: 오늘 ETF 가 전일보다 내렸으면 15:21 시장가 매수(장 마감 동시호가) → 다음 날 08:45 시장가 매도(장 시작 동시호가)
# 단타와 같은 돈을 씀 (9시에 판 돈으로 단타 매수). 끄려면 false
KW_ETF_ENABLED=true
KW_ETF_CODE=229200
KW_ETF_PCT=100
KW_ETF_MAX_CHANGE=0

# 수익 적립금: 수익 난 날 하루 손익(ETF 오버나이트 + 단타)의 N% 를 주문 금액에서 빼 둠 (0 = 끔)
# 운용금(평가금액 - 적립금)이 KW_RESERVE_FLOOR 아래로 떨어지면 적립금에서 꺼내 채움
# 입출금은 12:05~15:00 사이에만 (그때 평가금액 변화는 손익이 아니라 입출금으로 처리, 출금은 적립금에서 먼저 차감)
KW_RESERVE_PCT=50
KW_RESERVE_FLOOR=1000000

# 토스 스윙 봇이 들고 있는 종목은 건너뜀 (토스 봇 상태 파일, 확인 안 하려면 none)
KW_SWING_STATE_FILE=state/state.json
KW_STATE_DIR=state_kiwoom
