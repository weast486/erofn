# 토스증권 WTS > 설정 > Open API 에서 발급
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 비워두면 계좌 목록의 첫 번째 종합매매(BROKERAGE) 계좌 사용
TOSS_ACCOUNT_SEQ=

# true 이면 시세/계좌는 실제로 조회하되 주문은 보내지 않고 모의 체결 처리 (기본값 true)
DRY_RUN=true

# 전략: breakout = 20일 신고가 돌파 (기본) / pullback = 급등 후 이평선 터치 눌림목
STRATEGY=breakout

# 자금: 동시 보유 최대 NUM_STOCKS 종목, 종목당 TOTAL_BUDGET / NUM_STOCKS
TOTAL_BUDGET=1000000
NUM_STOCKS=10

# 손절(-%, 시장가) / 익절(+%, 지정가) — 토스증권 조건주문으로 서버에 등록
STOP_LOSS_PCT=4.7
TAKE_PROFIT_PCT=20
USE_CONDITIONAL_ORDERS=true
# 조건주문 만료일 = 등록일 + N일 (만료되면 자동으로 다시 등록)
CONDITIONAL_EXPIRE_DAYS=30
# 최대 보유 거래일 (0 = 제한 없음: 손절·익절이 걸릴 때까지 보유)
MAX_HOLD_DAYS=0
TIME_EXIT_TIME=15:10

# 매수 시간대 (신고가 전략은 종가 무렵, 하루 한 번)
BUY_START=15:10
BUY_END=15:20
# 감시 주기(초): 손절·익절 백업 감시
MONITOR_INTERVAL_SECONDS=60

# ---- 신고가 돌파 조건 (STRATEGY=breakout) ----
# 종가 기준 N일 신고가
BREAKOUT_ENTRY_DAYS=20
# 직전 N거래일 안에 신고가가 없던 '첫 신고가'만
BREAKOUT_FIRST_IN_DAYS=20
# 당일 거래대금 하한 (200억)
MIN_DAY_AMOUNT=20000000000
# 직전 20일 평균 거래대금 하한 (30억)
MIN_AVG_TRADING_AMOUNT=3000000000
# 시장 필터: kospi_not_down = 코스피가 전일 종가보다 낮으면 매수 금지 / none = 필터 없음
#            kospi_down = 코스피가 전일 종가보다 낮을 때만 매수
MARKET_FILTER=kospi_not_down

# ---- 눌림목 조건 (STRATEGY=pullback 일 때만 사용) ----
SURGE_PCT=10
SURGE_LOOKBACK_DAYS=10
MA_PERIOD=7
MA_MAX_BREAK_PCT=1.5
REQUIRE_MA_RISING=true
REBUY_COOLDOWN_DAYS=5
MIN_DAYS_AFTER_SURGE=3
PULLBACK_VOLUME_RATIO=0.5

STATE_DIR=state
LOG_DIR=logs
