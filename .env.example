# 토스증권 WTS > 설정 > Open API 에서 발급
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 비워두면 계좌 목록의 첫 번째 종합매매(BROKERAGE) 계좌 사용
TOSS_ACCOUNT_SEQ=

# true 이면 시세/계좌는 실제로 조회하되 주문은 보내지 않고 모의 체결 처리 (기본값 true)
DRY_RUN=true

# 자금: 동시 보유 최대 NUM_STOCKS 종목, 종목당 TOTAL_BUDGET / NUM_STOCKS
TOTAL_BUDGET=1000000
NUM_STOCKS=10

# 손절(-%, 시장가) / 익절(+%, 지정가). 둘 중 하나가 걸릴 때까지 보유
STOP_LOSS_PCT=4.7
TAKE_PROFIT_PCT=15
# 손절/익절을 토스증권 조건주문으로 서버에 걸어둠 (false 면 봇 가격감시만 사용)
USE_CONDITIONAL_ORDERS=true
# 조건주문 만료일 = 등록일 + N일 (만료되면 자동으로 다시 등록)
CONDITIONAL_EXPIRE_DAYS=30

# 매수 가능 시간대 (매 거래일, 신호가 나오면 이 시간 안에서 언제든 매수)
BUY_START=09:00
BUY_END=15:20
# 감시 주기(초): 18일선 도달 확인 + 손절/익절 백업 감시
MONITOR_INTERVAL_SECONDS=60

# 눌림목 조건
# 최근 SURGE_LOOKBACK_DAYS 거래일 안에 하루 SURGE_PCT% 이상 급등한 종목이
SURGE_PCT=10
SURGE_LOOKBACK_DAYS=10
# MA_PERIOD 일선을 터치하면(현재가 <= 이평선) 매수.
# 단 이평선보다 MA_MAX_BREAK_PCT% 넘게 아래면 이미 이탈한 것으로 보고 매수하지 않음
MA_PERIOD=18
MA_MAX_BREAK_PCT=1.5
# 이평선이 상승 중인 종목만 (false 면 무시)
REQUIRE_MA_RISING=true
# 20일 평균 거래대금 하한 (30억)
MIN_AVG_TRADING_AMOUNT=3000000000
# 매도한 종목은 N일 동안 다시 사지 않음
REBUY_COOLDOWN_DAYS=5
# 급등일로부터 N거래일째부터 매수 허용 (급등 직후 18일선 터치 = 급등분 반납이므로 제외)
MIN_DAYS_AFTER_SURGE=3
# 급등 이후 평균 거래량이 급등일 거래량 x N 이하인 '거래량 줄어든 눌림'만 매수
PULLBACK_VOLUME_RATIO=0.5
# 최대 보유 기간: 손절·익절 없이 N거래일이 지나면 그날 TIME_EXIT_TIME 에 시장가 매도 (0 = 제한 없음)
MAX_HOLD_DAYS=10
TIME_EXIT_TIME=15:10

STATE_DIR=state
LOG_DIR=logs
