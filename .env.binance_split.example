# 바이낸스 SOXL 스플릿 매매 봇 설정. 이 파일을 복사해 .env.binance_split 로 저장하세요 (.env.binance_split 는 git 에 올라가지 않음)
# 같은 계좌에서 FVG 봇(.env.binance)도 돌린다면 서브 계정을 만들어 그 키를 넣는 걸 권해요.
# 같은 키를 쓰려면 .env.binance 의 BN_EXCLUDE 에 SOXLUSDT 를 넣어야 실제 주문이 시작돼요 (포지션이 섞이지 않게).
# API 키: "선물 거래 허용(Enable Futures)" 만 켜고 출금 허용은 절대 켜지 마세요.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 주문 없이 로그만(true). 실제 주문은 false — 드라이런으로 며칠 확인한 뒤 바꾸세요
BINANCE_DRY_RUN=true

SP_SYMBOL=SOXLUSDT
# 봇이 굴릴 시작 금액 (USDT). 계좌 잔고가 아니라 봇 장부로 복리 계산 (새 사이클을 시작할 때만 장부 / 분할 수로 나눔)
# 차수당 금액 = 장부 / SP_SPLITS x SP_LEVERAGE 가 최소 주문 금액(5 USDT) 아래로 내려가면 봇이 멈춰요
# 15분할이면 100 USDT 는 차수당 6.7 USDT 라 25% 만 잃어도 멈춤 → 200 USDT 이상 권장
SP_CAPITAL=200
# 사용자 선택(2026-10-24): 예전 규칙(전 차수 익절 뒤 고점 -2% 에서 재진입, 1차도 1간격 익절)에서 가장 좋았던 20분할 3배 손절 1간격
# 백테스트(SOXL 2026-05-15~10-23, 100 USDT 복리, 모두 지정가): 100 → 634$ (익절 10,476번·손절 47번, 7월 SOXL -57% 에 310 → 266$),
#   2배는 394$. 10번 중 1번 시장가(+미끄러짐 0.1%)면 3배 369$ — 체결이 지정가로 잘 받아지는지가 핵심
#   바로 재진입·1차 2간격으로 바꾸면 173$ 로 나빠짐 (SP_REENTRY_DROP=2, SP_FIRST_TP_STEPS=1)
# 같은 규칙을 주식 토큰 41개에 넓히면 본전 수준 (SOXL 한 종목 결과), 3배는 손절 한 번이 크고 급락 때 크게 흔들림
SP_SPLITS=20
SP_LEVERAGE=3
# 1차 ~ 박스 바닥 폭 (%). 간격 = 1차 가격 x 박스% / 분할 수
SP_BOX_PCT=10
# 손절 = 마지막 차수 - 간격 x 이 값 (20분할은 1 이 2 보다 나았음, 10~15분할은 2 가 나았음)
SP_STOP_STEPS=1
# 익절 = 매수가 + 간격 + 매수가 x 이 %
SP_TP_EXTRA_PCT=0.1
# 1차만 익절 = 매수가 + 간격 x 이 값 + 0.1% (나머지 차수는 1간격)
SP_FIRST_TP_STEPS=1
# 모든 차수 익절 뒤 고점에서 이 % 내려오면 1차부터 다시 (0 = 기다리지 않고 바로 재진입)
SP_REENTRY_DROP=2
# 재진입 1차를 그 가격에 미리 거는 지정가(Post Only)로 (false = 가격에 닿으면 시장가)
SP_REENTRY_LIMIT=true
# 미국 주말(동부 금 16:00 ~ 월 9:30)에는 재진입가 = 직전 사이클 1차 가격과 고점 -2% 중 높은 쪽 (2026-10-26 사용자 결정)
#   백테스트 20분할 3배 634 → 731$ 였지만 한국 주말 기준이면 568$, 15분할은 나빠지는 등 방향이 일정하지 않았음
SP_WEEKEND_FIRST=true
# 바이낸스 레버리지 설정값과 마진 방식 (격리 = 이 종목 손실이 다른 돈에 번지지 않음)
SP_EXCHANGE_LEVERAGE=5
SP_MARGIN_TYPE=ISOLATED
SP_POLL_SECONDS=2
SP_STATE_DIR=state_binance_split
# 같은 계좌 FVG 봇 설정 파일 (종목 겹침 확인용)
SP_FVG_ENV=.env.binance
