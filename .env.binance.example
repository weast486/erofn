# 바이낸스 선물 자동매매 봇 설정 (첫 5분봉 + 1분봉 FVG). 이 파일을 복사해 .env.binance 로 저장하고 키를 넣으세요 (.env.binance 는 git 에 올라가지 않음)
# API 키 만들기: 바이낸스 > 계정 > API 관리 > 키 만들기 → "선물 거래 허용(Enable Futures)" 만 켜고, 출금 허용은 절대 켜지 마세요. IP 제한을 걸면 더 안전해요.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 처음에는 반드시 드라이런(true): 주문 없이 로그만 남김. 며칠 지켜본 뒤 false 로 (그때도 작은 금액부터)
BINANCE_DRY_RUN=true

# 전략 (백테스트 2026-01~10 최고 조합: 2배 +500%, MDD -22%)
BN_LEVERAGE=2
BN_TOP_N=10
# 순위와 상관없이 늘 넣을 종목 (예 BTCUSDT,ETHUSDT). 백테스트 안 된 조건이라 기본은 비움
BN_EXTRA_SYMBOLS=
BN_TARGET_R=2
BN_EXIT_MINUTES=350
BN_SIDE=both
BN_ENTRY=full
BN_LOC=zone
BN_POLL_SECONDS=1
# 키 없이 드라이런할 때 쓸 평가금액 (USDT)
BN_DRY_EQUITY=1000
BN_STATE_DIR=state_binance
